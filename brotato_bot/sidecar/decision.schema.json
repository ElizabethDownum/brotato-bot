{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["buy", "reroll", "lock", "skip", "pick", "revise_plan"]
    },
    "option_index": {"type": "integer", "minimum": 0},
    "plan_patch": {
      "type": "object",
      "description": "Plan keys to merge into plan.json; only these keys, with these types.",
      "properties": {
        "weapon_type": {"type": "string", "enum": ["ranged", "melee", "any"]},
        "stats": {"type": "object", "additionalProperties": {"type": "number"}},
        "item_bonus": {"type": "object", "additionalProperties": {"type": "number"}},
        "steering": {
          "type": "object",
          "properties": {
            "tree_value": {"type": "number"},
            "sweep": {"type": "number"},
            "sweep_radius": {"type": "number"},
            "gold_value": {"type": "number"},
            "stand_continuity": {"type": "number"},
            "tree_policy": {"type": "string", "enum": ["auto", "seek", "preserve"]}
          },
          "additionalProperties": false
        },
        "phase_boost": {
          "type": "object",
          "properties": {
            "until_wave": {"type": "integer"},
            "stats": {"type": "object", "additionalProperties": {"type": "number"}}
          },
          "additionalProperties": false
        },
        "harvest_cap": {"type": "integer"},
        "max_weapons": {"type": "integer"},
        "reroll_keep": {"type": "integer"},
        "max_rerolls": {"type": "integer"},
        "gold_floor": {"type": "integer"},
        "min_buy": {"type": "number"},
        "prefer_weapons": {"type": "array", "items": {"type": "string"}},
        "ban_items": {"type": "array", "items": {"type": "string"}},
        "deprioritize_weapons": {"type": "array", "items": {"type": "string"}},
        "ask_on": {"type": "array", "items": {"type": "string"}},
        "weapon_set": {"type": "string"},
        "unique_weapons": {"type": "boolean"},
        "stack_combine": {"type": "boolean"},
        "hitrate_pref": {"type": "boolean"},
        "spend_surplus": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "maxLength": 300},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["action", "confidence", "rationale", "tags"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"action": {"enum": ["buy", "lock", "pick"]}},
        "required": ["action"]
      },
      "then": {"required": ["option_index"]}
    },
    {
      "if": {
        "properties": {"action": {"enum": ["revise_plan"]}},
        "required": ["action"]
      },
      "then": {"required": ["plan_patch"]}
    }
  ]
}
